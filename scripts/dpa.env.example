# Copy to VPS as /etc/dpa-app/dpa.env (chmod 600). Do not commit real secrets.
DPA_ENV=production
DPA_API_KEY=replace-with-openssl-rand-hex-32
# SQLite backend (after migrate_json_to_db.py). See docs/ADR-001-database.md, docs/OPERATIONS.md
# DPA_PERSISTENCE=sqlite
# DPA_DATABASE_URL=sqlite:////opt/dpa_app/data/dpa.db
# Import once: python scripts/migrate_json_to_db.py --data-dir /opt/dpa_app [--dry-run] [--archive-json]
